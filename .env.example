GEMINI_API_KEY=your_gemini_api_key_here
# LangSmith tracing sends prompts/logs to a third-party service. Opt in explicitly.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=genai-log-analyzer
GEMINI_MODEL=gemini-3.6-flash

# Vector DB Configuration
VECTOR_DB_TYPE=chroma
CHROMA_PATH=./data/chroma
# Logs per embedding call when /ingest indexes into Chroma in the background
VECTOR_INDEX_CHUNK=64
# Seconds between batched audit-trail commits to Delta Lake
AUDIT_FLUSH_SECONDS=5

# Kafka Configuration (add "kafka" to ENABLED_CONNECTORS to activate).
# docker-compose overrides the bootstrap address to kafka:29092 for the api service.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
LOG_TOPIC=logs-raw
KAFKA_GROUP_ID=log-analyzer-group
# Max records handed to the ingestion pipeline per batch; offsets are committed after each batch.
KAFKA_MAX_BATCH=500

# Log-format profile (processing/format_profiles.yaml): maps a platform's field names
# (e.g. _time/log_level/svc/msg) onto timestamp/severity/source/message before processing.
# Profiles: generic, siem_hec, acme_insight, acme_ai_platform (or add your own).
# LOG_FORMAT_PROFILE is the default for every channel; KAFKA_FORMAT_PROFILE overrides it
# for Kafka. POST /ingest also accepts a per-request "format" field.
LOG_FORMAT_PROFILE=generic
KAFKA_FORMAT_PROFILE=

# IP enrichment (processing/ip_intel.py). Both sources are optional; with neither set, it is off.
# GeoLite2-Country.mmdb or GeoLite2-City.mmdb from MaxMind (free account required).
GEOIP_DB_PATH=
# AbuseIPDB key (free tier: 1,000 checks/day). Lookups stop for the day at ABUSEIPDB_DAILY_LIMIT.
ABUSEIPDB_API_KEY=
ABUSEIPDB_DAILY_LIMIT=900
# abuseConfidenceScore at or above this marks the IP as malicious.
ABUSEIPDB_MALICIOUS_SCORE=50
IP_INTEL_CACHE_SECONDS=86400
# Comma-separated log fields that hold IPs to enrich. Only public addresses are looked up.
IP_ENRICH_FIELDS=source_ip

# Ticketing (core/ticketing.py). Each provider is enabled when its variables are set.
# Tickets open when an open incident reaches this level: low, medium, high, critical.
TICKET_MIN_SEVERITY=high
# Optional link added to ticket descriptions: <base>/<incident id>
TICKET_INCIDENT_URL_BASE=
# PagerDuty Events API v2. Per-team keys override the default: PAGERDUTY_ROUTING_KEY_PAYMENTS=...
PAGERDUTY_ROUTING_KEY=
# ServiceNow incident table. Per-team group: SERVICENOW_ASSIGNMENT_GROUP_PAYMENTS=...
SERVICENOW_INSTANCE=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
SERVICENOW_ASSIGNMENT_GROUP=
SERVICENOW_RESOLVED_STATE=6
SERVICENOW_CLOSE_CODE=Solved (Permanently)
# Generic webhook. With a secret, X-Signature-256 carries sha256=<HMAC of the body>.
TICKET_WEBHOOK_URL=
TICKET_WEBHOOK_SECRET=

# Storage Configuration
DELTA_LAKE_PATH=./data/delta-lake

# API Auth (Opt-in). Keys live in SQLite; issue them with scripts/manage_keys.py
ENABLE_AUTH=false
API_KEYS_DB=./data/api_keys.sqlite3

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_INGEST=50/minute
RATE_LIMIT_ANALYZE=10/minute

ENABLED_DETECTORS=error_spike
ENABLED_ANALYZERS=simple_summary,gemini_triage
ERROR_SPIKE_THRESHOLD=3
# Minimum seconds between incidents. 0 disables dedup and raises an incident
# on every error once the threshold is crossed.
ERROR_SPIKE_COOLDOWN_SECONDS=60

# Incident triage (core/triage.py)
INCIDENTS_DB=./data/incidents.sqlite3
OWNERSHIP_FILE=./config/ownership.yaml
# Hits sharing a source with an open incident seen within this window are grouped. 0 disables.
INCIDENT_GROUP_WINDOW_SECONDS=900
# Deployments this long before an incident started are linked to it.
DEPLOY_CORRELATION_WINDOW_SECONDS=1800
# Knowledge-base matches with a larger distance are not given to the LLM.
KNOWLEDGE_MAX_DISTANCE=1.5